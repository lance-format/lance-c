+#[tokio::test]
+async fn test_inverted_last_as_prefix_merges_fragments_before_truncation() {
+    let first = RecordBatch::try_from_iter(vec![
+        ("id", Arc::new(Int32Array::from(vec![0, 1])) as ArrayRef),
+        (
+            "text",
+            Arc::new(StringArray::from(vec![Some("alpha"), Some("alpenglow")])) as ArrayRef,
+        ),
+    ])
+    .unwrap();
+    let second = RecordBatch::try_from_iter(vec![
+        ("id", Arc::new(Int32Array::from(vec![2, 3])) as ArrayRef),
+        (
+            "text",
+            Arc::new(StringArray::from(vec![Some("alphabet"), Some("alpine")])) as ArrayRef,
+        ),
+    ])
+    .unwrap();
+
+    let test_dir = tempfile::tempdir().unwrap();
+    let mut ds = Dataset::write(
+        RecordBatchIterator::new(vec![Ok(first.clone())], first.schema()),
+        test_dir.path().to_str().unwrap(),
+        None,
+    )
+    .await
+    .unwrap();
+    ds.create_index(
+        &["text"],
+        IndexType::Inverted,
+        None,
+        &base_inverted_params(false),
+        true,
+    )
+    .await
+    .unwrap();
+    ds.append(
+        RecordBatchIterator::new(vec![Ok(second.clone())], second.schema()),
+        None,
+    )
+    .await
+    .unwrap();
+    assert_eq!(ds.fragments().len(), 2);
+    // The appended fragment must be indexed; the flat fallback has no
+    // vocabulary expansion and would otherwise match `alp` exactly.
+    ds.optimize_indices(&OptimizeOptions::append())
+        .await
+        .unwrap();
+
+    let prefix = |max_expansions: usize| {
+        FullTextSearchQuery::new_query(FtsQuery::Match(
+            MatchQuery::new("alp".to_string())
+                .with_column(Some("text".to_string()))
+                .with_last_as_prefix(true)
+                .with_max_expansions(max_expansions),
+        ))
+    };
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, prefix(4), None).await),
+        vec![0, 1, 2, 3],
+        "prefix candidates merge across indexed fragments"
+    );
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, prefix(2), None).await),
+        vec![0, 1],
+        "the shared budget truncates the merged vocabulary, not each fragment"
+    );
+}
