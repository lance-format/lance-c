+#[tokio::test]
+async fn test_inverted_last_as_prefix_respects_list_element_boundaries() {
+    let batch = RecordBatch::try_from_iter(vec![
+        (
+            "id",
+            Arc::new(Int32Array::from(vec![0, 1, 2, 3])) as ArrayRef,
+        ),
+        (
+            "tags",
+            string_lists(&[
+                Some(vec![Some("alpha"), Some("beta")]),
+                Some(vec![Some("alphabet")]),
+                Some(vec![Some("al"), Some("pha")]),
+                Some(vec![Some("alp"), Some("ine")]),
+            ]),
+        ),
+    ])
+    .unwrap();
+    let schema = batch.schema();
+    let test_dir = tempfile::tempdir().unwrap();
+    let mut ds = Dataset::write(
+        RecordBatchIterator::new(vec![Ok(batch)], schema),
+        test_dir.path().to_str().unwrap(),
+        None,
+    )
+    .await
+    .unwrap();
+    ds.create_index(
+        &["tags"],
+        IndexType::Inverted,
+        None,
+        &list_element_params(true),
+        true,
+    )
+    .await
+    .unwrap();
+
+    let prefix = FullTextSearchQuery::new_query(FtsQuery::Match(
+        list_element_match_node("tags", "alp").with_last_as_prefix(true),
+    ));
+    let indexed = run_fts(&ds, prefix, None).await;
+    assert_eq!(
+        element_hits(&indexed),
+        vec![(0, vec![0]), (1, vec![0]), (3, vec![0])],
+        "prefix matching stays inside each list element"
+    );
+
+    let exact = run_fts(&ds, list_element_match("tags", "alp"), None).await;
+    assert_eq!(
+        element_hits(&exact),
+        vec![(3, vec![0])],
+        "without last_as_prefix the same query only matches the exact element"
+    );
+}
