+                .with_max_expansions(max_expansions),
+        ))
+    };
+    let prefix_and = |terms: &str, max_expansions: usize| {
+        FullTextSearchQuery::new_query(FtsQuery::Match(
+            MatchQuery::new(terms.to_string())
+                .with_column(Some("text".to_string()))
+                .with_last_as_prefix(true)
+                .with_max_expansions(max_expansions)
+                .with_operator(Operator::And),
+        ))
+    };
+
+    let exact_alp = FullTextSearchQuery::new_query(FtsQuery::Match(
+        MatchQuery::new("alp".to_string()).with_column(Some("text".to_string())),
+    ));
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, exact_alp, None).await),
+        Vec::<i32>::new(),
+        "the exact token alp is absent from the indexed vocabulary"
+    );
+
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, prefix("alp", 8), None).await),
+        vec![0, 1, 2, 3, 4],
+        "the highest analyzed position matches vocabulary terms by prefix"
+    );
+
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, prefix_and("alpha alpe", 8), None).await),
+        vec![0],
+        "only the highest position is a prefix; alpha stays exact"
+    );
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, prefix_and("alpe alpha", 8), None).await),
+        Vec::<i32>::new(),
+        "an earlier position must not gain prefix semantics"
+    );
+
+    let exact_node =
+        |terms: &str| MatchQuery::new(terms.to_string()).with_column(Some("text".to_string()));
+    let prefix_node = |terms: &str| {
+        MatchQuery::new(terms.to_string())
+            .with_column(Some("text".to_string()))
+            .with_last_as_prefix(true)
+    };
+    let must: BooleanQuery = BooleanQuery::new([
+        (Occur::Must, FtsQuery::Match(exact_node("alpha"))),
+        (Occur::Must, FtsQuery::Match(prefix_node("alpe"))),
+    ]);
+    assert_eq!(
+        scanned_ids(
+            &run_fts(
+                &ds,
+                FullTextSearchQuery::new_query(FtsQuery::Boolean(must)),
+                None
+            )
+            .await
+        ),
+        vec![0],
+        "Boolean Must composes a prefix leaf without changing its semantics"
+    );
+    let should: BooleanQuery = BooleanQuery::new([
+        (Occur::Should, FtsQuery::Match(prefix_node("alpe"))),
+        (Occur::Should, FtsQuery::Match(exact_node("beta"))),
+    ]);
+    assert_eq!(
+        scanned_ids(
+            &run_fts(
+                &ds,
+                FullTextSearchQuery::new_query(FtsQuery::Boolean(should)),
+                None
+            )
+            .await
+        ),
+        vec![0, 2, 5],
+        "Boolean Should composes prefix and exact leaves by position"
+    );
+
+    let plain = run_fts(&ds, prefix("alp", 8), None).await;
+    let boosted = run_fts(
+        &ds,
+        FullTextSearchQuery::new_query(FtsQuery::Match(prefix_node("alp").with_boost(2.0))),
+        None,
+    )
+    .await;
+    let plain_score = plain["_score"]
+        .as_primitive::<arrow_array::types::Float32Type>()
+        .value(0);
+    let boosted_score = boosted["_score"]
+        .as_primitive::<arrow_array::types::Float32Type>()
+        .value(0);
+    assert!(
+        (boosted_score - 2.0 * plain_score).abs() < 1e-5,
+        "boost must scale the prefix leaf score: plain={plain_score}, boosted={boosted_score}"
+    );
+
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, prefix_and("alpha alp", 2), None).await),
+        Vec::<i32>::new(),
+        "the earlier exact alternative consumes the shared budget"
+    );
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, prefix_and("alpha alp", 3), None).await),
+        vec![0],
+        "one more unit of budget reaches alpenglow at the last position"
+    );
+
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, prefix_and("alpha alpe!!", 8), None).await),
+        vec![0],
+        "trailing punctuation is removed before the prefix is taken"
+    );
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, prefix_and("alpha alpe   ", 8), None).await),
+        vec![0],
+        "trailing whitespace is removed before the prefix is taken"
+    );
+    assert_eq!(
+        scanned_ids(&run_fts(&ds, prefix("!!!", 8), None).await),
+        Vec::<i32>::new(),
+        "an empty analysis matches nothing"
+    );
+}
