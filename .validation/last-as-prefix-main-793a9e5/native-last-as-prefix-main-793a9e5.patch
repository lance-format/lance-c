+#[tokio::test]
+async fn test_last_as_prefix_shares_one_budget_across_positions(
+    #[case] max_expansions: usize,
+    #[case] expected: &[(&str, u32, u32)],
+) {
+    let (_tmpdir, index) = load_prefix_test_index().await;
+    let params = FtsSearchParams::new()
+        .with_fuzziness(Some(0))
+        .with_last_as_prefix(true)
+        .with_max_expansions(max_expansions);
+    let tokens = Tokens::with_positions(
+        vec!["alpha".to_owned(), "alp".to_owned()],
+        vec![0, 1],
+        DocType::Text,
+    )
+    .with_term_groups(vec![0, 1]);
+
+    for expanded in [
+        index.partitions[0].expand_fuzzy(&tokens, &params).unwrap(),
+        index.expand_fuzzy_tokens(&tokens, &params).unwrap(),
+        crate::scalar::inverted::final_query_tokens(std::slice::from_ref(&index), &tokens, &params)
+            .unwrap(),
+    ] {
+        assert_eq!(
+            expanded_triples(&expanded),
+            expected,
+            "prefix and earlier exact terms must share one max_expansions budget, consumed in position and lexicographic order (max_expansions={max_expansions})"
+        );
+    }
+}
