+/// One partition whose vocabulary is `alp*` plus `beta`. Used to pin the
+/// `last_as_prefix` rewrite without a dataset: group 0 is an earlier analyzed
+/// position, group 1 the highest one.
+async fn load_prefix_test_index() -> (TempObjDir, Arc<InvertedIndex>) {
+    let tmpdir = TempObjDir::default();
+    let store = Arc::new(LanceIndexStore::new(
+        ObjectStore::local().into(),
+        tmpdir.clone(),
+        Arc::new(LanceCache::no_cache()),
+    ));
+
+    let mut builder = InnerBuilder::new(0, false, TokenSetFormat::default());
+    let vocabulary = ["alp", "alpenglow", "alpha", "alphabet", "alpine", "beta"];
+    for token in vocabulary {
+        builder.tokens.get_or_add(token);
+        builder.posting_lists.push(PostingListBuilder::new(false));
+    }
+    for token_id in 0..vocabulary.len() {
+        builder.posting_lists[token_id].add(token_id as u32, PositionRecorder::Count(1));
+        builder.docs.append(100 + token_id as u64, 1);
+    }
+    builder.write(store.as_ref()).await.unwrap();
+
+    write_test_metadata(&store, vec![0], InvertedIndexParams::default()).await;
+    let index = InvertedIndex::load(store.clone(), None, &LanceCache::no_cache())
+        .await
+        .unwrap();
+    (tmpdir, index)
+}
+
+fn expanded_triples(tokens: &Tokens) -> Vec<(&str, u32, u32)> {
+    (0..tokens.len())
+        .map(|idx| {
+            (
+                tokens.get_token(idx),
+                tokens.term_group(idx),
+                tokens.position(idx),
+            )
+        })
+        .collect()
+}
