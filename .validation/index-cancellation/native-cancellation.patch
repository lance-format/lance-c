+/// Wraps an existing progress observer with a cooperative cancellation token.
+///
+/// Every observer call first consults the token, then forwards to the wrapped
+/// observer. The adapter also overrides [`IndexBuildProgress::check_cancelled`],
+/// so native builders can consult the same token at non-stage checkpoints.
+/// Observer errors are forwarded unchanged and are not reclassified as
+/// cancellation.
+#[derive(Debug, Clone)]
+pub struct CancellableIndexBuildProgress {
+    inner: Arc<dyn IndexBuildProgress>,
+    cancellation: CancellationToken,
+}
+
+impl CancellableIndexBuildProgress {
+    pub fn new(inner: Arc<dyn IndexBuildProgress>, cancellation: CancellationToken) -> Self {
+        Self {
+            inner,
+            cancellation,
+        }
+    }
+
+    fn check_token(&self) -> Result<()> {
+        if self.cancellation.is_cancelled() {
+            Err(index_build_cancelled())
+        } else {
+            Ok(())
+        }
+    }
+}
+
+#[async_trait]
+impl IndexBuildProgress for CancellableIndexBuildProgress {
+    async fn stage_start(&self, stage: &str, total: Option<u64>, unit: &str) -> Result<()> {
+        self.check_cancelled().await?;
+        self.inner.stage_start(stage, total, unit).await
+    }
+
+    async fn stage_progress(&self, stage: &str, completed: u64) -> Result<()> {
+        self.check_cancelled().await?;
+        self.inner.stage_progress(stage, completed).await
+    }
+
+    async fn stage_complete(&self, stage: &str) -> Result<()> {
+        self.check_cancelled().await?;
+        self.inner.stage_complete(stage).await
+    }
+
+    async fn check_cancelled(&self) -> Result<()> {
+        self.check_token()?;
+        self.inner.check_cancelled().await
+    }
+}
