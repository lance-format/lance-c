+#[tokio::test]
+async fn checkout_before_no_match_reports_branch_and_retained_history() {
+    let test_uri = TempStrDir::default();
+    set_commit_time(10, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 0..3, WriteMode::Create).await;
+
+    let cutoff = checkout_before_time(10, 0);
+    let err = dataset.checkout_before(cutoff).await.unwrap_err();
+    assert!(matches!(err, Error::InvalidInput { .. }), "{err}");
+
+    let message = err.to_string();
+    assert!(message.contains("no retained version"), "{message}");
+    assert!(message.contains("'main'"), "{message}");
+    assert!(message.contains(&cutoff.to_string()), "{message}");
+    assert!(message.contains("cleaned up"), "{message}");
+}
