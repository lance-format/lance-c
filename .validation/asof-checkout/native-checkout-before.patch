+#[tokio::test]
+async fn checkout_before_strict_nanosecond_boundary_and_equal_timestamps() {
+    let test_uri = TempStrDir::default();
+    set_commit_time(10, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 0..3, WriteMode::Create).await;
+    set_commit_time(10, 1);
+    let dataset = write_checkout_version(test_uri.as_str(), 3..6, WriteMode::Append).await;
+    set_commit_time(10, 1);
+    let dataset = write_checkout_version(test_uri.as_str(), 6..9, WriteMode::Append).await;
+
+    assert_eq!(dataset.version_id(), 3);
+
+    // Versions 2 and 3 share a timestamp exactly equal to the cutoff, so the
+    // strict comparison excludes both and leaves version 1.
+    let selected = dataset
+        .checkout_before(checkout_before_time(10, 1))
+        .await
+        .unwrap();
+    assert_eq!(selected.version_id(), 1);
+    assert_eq!(scan_i_values(&selected).await, vec![0, 1, 2]);
+
+    // One nanosecond later both tied versions are eligible; the greater
+    // numeric version wins.
+    let selected = dataset
+        .checkout_before(checkout_before_time(10, 2))
+        .await
+        .unwrap();
+    assert_eq!(selected.version_id(), 3);
+    assert_eq!(scan_i_values(&selected).await, (0..9).collect::<Vec<_>>());
+}
