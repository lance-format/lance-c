+#[tokio::test]
+async fn checkout_before_ignores_removed_history() {
+    let test_uri = TempStrDir::default();
+    set_commit_time(10, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 0..3, WriteMode::Create).await;
+    set_commit_time(30, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 3..6, WriteMode::Append).await;
+    set_commit_time(20, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 6..9, WriteMode::Append).await;
+    set_commit_time(40, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 9..12, WriteMode::Append).await;
+    assert_eq!(dataset.version_id(), 4);
+
+    let policy = CleanupPolicyBuilder::default()
+        .versions(vec![3])
+        .unwrap()
+        .build();
+    let removed = dataset.cleanup(policy).execute().await.unwrap();
+    assert_eq!(removed.old_versions, 1);
+    assert_eq!(
+        dataset
+            .version_refs()
+            .await
+            .unwrap()
+            .iter()
+            .map(|version| version.version)
+            .collect::<Vec<_>>(),
+        vec![1, 2, 4]
+    );
+
+    // Version 3 was committed at 20s and would have been selected at 25s, but
+    // cleanup removed it. Only retained version 1 remains eligible.
+    let selected = dataset
+        .checkout_before(checkout_before_time(25, 0))
+        .await
+        .unwrap();
+    assert_eq!(selected.version_id(), 1);
+    assert_eq!(scan_i_values(&selected).await, vec![0, 1, 2]);
+}
