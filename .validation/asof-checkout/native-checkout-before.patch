+#[tokio::test]
+async fn checkout_before_limits_history_to_the_current_branch() {
+    let test_uri = TempStrDir::default();
+    set_commit_time(10, 0);
+    let mut main = write_checkout_version(test_uri.as_str(), 0..3, WriteMode::Create).await;
+    set_commit_time(30, 0);
+    main = write_checkout_version(test_uri.as_str(), 3..6, WriteMode::Append).await;
+
+    let mut dev = main.create_branch("dev", 2, None).await.unwrap();
+    set_commit_time(20, 0);
+    dev = write_checkout_version(dev.uri(), 100..103, WriteMode::Append).await;
+    assert_eq!(dev.version_id(), 3);
+
+    // Main retains versions 1 (10s) and 2 (30s), so only version 1 is eligible.
+    let selected = main
+        .checkout_before(checkout_before_time(25, 0))
+        .await
+        .unwrap();
+    assert_eq!(selected.version_id(), 1);
+    assert_eq!(selected.manifest.branch, None);
+    assert_eq!(scan_i_values(&selected).await, vec![0, 1, 2]);
+
+    // The branch's own version 3 (20s) is eligible even though its parent
+    // version 2 has a later timestamp.
+    let selected = dev
+        .checkout_before(checkout_before_time(25, 0))
+        .await
+        .unwrap();
+    assert_eq!(selected.version_id(), 3);
+    assert_eq!(selected.manifest.branch.as_deref(), Some("dev"));
+    let mut values = scan_i_values(&selected).await;
+    values.sort_unstable();
+    assert_eq!(values, vec![0, 1, 2, 3, 4, 5, 100, 101, 102]);
+}
