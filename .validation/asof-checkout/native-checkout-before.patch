diff --git a/rust/lance/src/dataset.rs b/rust/lance/src/dataset.rs
index 6d18cdb8c..a3614606d 100644
--- a/rust/lance/src/dataset.rs
+++ b/rust/lance/src/dataset.rs
@@ -545,6 +545,31 @@ impl Dataset {
         }
     }
 
+    /// Check out the greatest retained version committed strictly before `cutoff`.
+    ///
+    /// Only versions in the current branch's retained history are considered. A
+    /// version removed by cleanup cannot be recovered, so a cutoff may have no
+    /// match even when it falls after an earlier commit timestamp.
+    pub async fn checkout_before(&self, cutoff: DateTime<Utc>) -> Result<Self> {
+        let version = self
+            .versions()
+            .await?
+            .into_iter()
+            .filter(|version| version.timestamp < cutoff)
+            .max_by_key(|version| version.version)
+            .ok_or_else(|| {
+                Error::invalid_input(format!(
+                    "no retained version of branch '{}' was committed strictly before {}. \
+                     The retained history may not reach back to the cutoff, or earlier \
+                     versions may have been cleaned up.",
+                    refs::normalize_branch(self.manifest.branch.as_deref()),
+                    cutoff
+                ))
+            })?;
+
+        self.checkout_version(version.version).await
+    }
+
     pub fn tags(&self) -> Tags<'_> {
         self.refs.tags()
     }
