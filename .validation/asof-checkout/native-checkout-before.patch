+#[tokio::test]
+async fn checkout_before_selects_greatest_eligible_version() {
+    let test_uri = TempStrDir::default();
+    set_commit_time(10, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 0..5, WriteMode::Create).await;
+    set_commit_time(30, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 5..10, WriteMode::Append).await;
+    set_commit_time(20, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 10..15, WriteMode::Append).await;
+
+    assert_eq!(dataset.version_id(), 3);
+    assert_eq!(scan_i_values(&dataset).await, (0..15).collect::<Vec<_>>());
+    assert!(dataset.get_fragments().len() > 1);
+
+    // The earliest retained commit is excluded by the strict comparison.
+    let err = dataset
+        .checkout_before(checkout_before_time(10, 0))
+        .await
+        .unwrap_err();
+    assert!(matches!(err, Error::InvalidInput { .. }), "{err}");
+
+    // Version 3 has the same timestamp as the cutoff, so version 1 is the
+    // greatest eligible version; version 2 was committed later.
+    let selected = dataset
+        .checkout_before(checkout_before_time(20, 0))
+        .await
+        .unwrap();
+    assert_eq!(selected.version_id(), 1);
+    assert_eq!(scan_i_values(&selected).await, vec![0, 1, 2, 3, 4]);
+    assert!(selected.get_fragments().len() > 1);
+
+    // Version 3 is eligible at 25s even though version 2 has a newer timestamp.
+    let selected = dataset
+        .checkout_before(checkout_before_time(25, 0))
+        .await
+        .unwrap();
+    assert_eq!(selected.version_id(), 3);
+    assert_eq!(scan_i_values(&selected).await, (0..15).collect::<Vec<_>>());
+
+    // All versions are eligible at 31s; the greatest numeric version wins.
+    let selected = dataset
+        .checkout_before(checkout_before_time(31, 0))
+        .await
+        .unwrap();
+    assert_eq!(selected.version_id(), 3);
+    assert_eq!(scan_i_values(&selected).await, (0..15).collect::<Vec<_>>());
+
+    assert_eq!(dataset.version_id(), 3);
+    assert_eq!(scan_i_values(&dataset).await, (0..15).collect::<Vec<_>>());
+}
