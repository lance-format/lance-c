+fn checkout_before_time(seconds: i64, nanos: u32) -> DateTime<Utc> {
+    DateTime::from_timestamp(seconds, nanos).unwrap()
+}
+
+fn set_commit_time(seconds: u64, nanos: u32) {
+    MockClock::set_system_time(std::time::Duration::new(seconds, nanos));
+}
+
+async fn write_checkout_version(
+    uri: &str,
+    values: std::ops::Range<u32>,
+    mode: WriteMode,
+) -> Dataset {
+    let batch = u32_batch(values);
+    Dataset::write(
+        RecordBatchIterator::new([Ok(batch.clone())], batch.schema()),
+        uri,
+        Some(WriteParams {
+            max_rows_per_file: 2,
+            max_rows_per_group: 2,
+            mode,
+            ..Default::default()
+        }),
+    )
+    .await
+    .unwrap()
+}
+
+async fn scan_i_values(dataset: &Dataset) -> Vec<u32> {
+    let batch = dataset.scan().try_into_batch().await.unwrap();
+    batch["i"].as_primitive::<UInt32Type>().values().to_vec()
+}
