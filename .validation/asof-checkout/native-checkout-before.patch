+#[tokio::test]
+async fn checkout_before_propagates_manifest_read_failure() {
+    let test_uri = TempStrDir::default();
+    set_commit_time(10, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 0..3, WriteMode::Create).await;
+    set_commit_time(20, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 3..6, WriteMode::Append).await;
+    set_commit_time(30, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 6..9, WriteMode::Append).await;
+
+    let locations = dataset
+        .commit_handler
+        .list_manifest_locations(&dataset.base, dataset.object_store.as_ref(), false)
+        .try_collect::<Vec<_>>()
+        .await
+        .unwrap();
+    let location = locations
+        .iter()
+        .find(|location| location.version == 2)
+        .unwrap();
+    dataset
+        .object_store
+        .delete(&location.path)
+        .await
+        .unwrap();
+
+    let err = dataset
+        .checkout_before(checkout_before_time(35, 0))
+        .await
+        .unwrap_err();
+    assert!(matches!(err, Error::NotFound { .. }), "{err}");
+}
