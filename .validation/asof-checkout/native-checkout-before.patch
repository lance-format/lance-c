+#[tokio::test]
+async fn checkout_before_old_handle_does_not_cap_history() {
+    let test_uri = TempStrDir::default();
+    set_commit_time(10, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 0..3, WriteMode::Create).await;
+    set_commit_time(20, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 3..6, WriteMode::Append).await;
+    set_commit_time(30, 0);
+    let dataset = write_checkout_version(test_uri.as_str(), 6..9, WriteMode::Append).await;
+
+    let old = dataset.checkout_version(1).await.unwrap();
+    assert_eq!(old.version_id(), 1);
+
+    let selected = old
+        .checkout_before(checkout_before_time(35, 0))
+        .await
+        .unwrap();
+    assert_eq!(selected.version_id(), 3);
+    assert_eq!(scan_i_values(&selected).await, (0..9).collect::<Vec<_>>());
+
+    assert_eq!(old.version_id(), 1);
+    assert_eq!(dataset.version_id(), 3);
+}
