+/// Matches vocabulary terms that start with the query token.
+///
+/// The whole analyzed token is the prefix. JSON vocabulary terms have the form
+/// `path,type,value`, so matching the token verbatim keeps the path and type
+/// exact and only lets the value grow, just like [`FuzzyAutomaton`] does for
+/// fuzzy matching.
+pub(in crate::scalar::inverted) struct PrefixAutomaton {
+    prefix: Vec<u8>,
+}
+
+impl PrefixAutomaton {
+    pub(in crate::scalar::inverted) fn new(token: &str) -> Self {
+        Self {
+            prefix: token.as_bytes().to_vec(),
+        }
+    }
+}
+
+impl Automaton for PrefixAutomaton {
+    /// Number of bytes of `prefix` consumed so far. `None` means the term
+    /// already diverged, and `Some(prefix.len())` means every further byte is
+    /// part of a matching term.
+    type State = Option<usize>;
+
+    #[inline]
+    fn start(&self) -> Self::State {
+        Some(0)
+    }
+
+    #[inline]
+    fn is_match(&self, state: &Self::State) -> bool {
+        *state == Some(self.prefix.len())
+    }
+
+    #[inline]
+    fn can_match(&self, state: &Self::State) -> bool {
+        state.is_some()
+    }
+
+    #[inline]
+    fn accept(&self, state: &Self::State, byte: u8) -> Self::State {
+        state.and_then(|position| {
+            if position == self.prefix.len() {
+                Some(position)
+            } else if self.prefix[position] == byte {
+                Some(position + 1)
+            } else {
+                None
+            }
+        })
+    }
+}
+
+/// Vocabulary expansion mode for one source token.
+pub(in crate::scalar::inverted) enum ExpansionAutomaton {
+    Fuzzy(FuzzyAutomaton),
+    Prefix(PrefixAutomaton),
+}
+
+pub(in crate::scalar::inverted) enum ExpansionAutomatonState {
+    Fuzzy(FuzzyAutomatonState),
+    Prefix(Option<usize>),
+}
+
+impl Automaton for ExpansionAutomaton {
+    type State = ExpansionAutomatonState;
+
+    #[inline]
+    fn start(&self) -> Self::State {
+        match self {
+            Self::Fuzzy(automaton) => ExpansionAutomatonState::Fuzzy(automaton.start()),
+            Self::Prefix(automaton) => ExpansionAutomatonState::Prefix(automaton.start()),
+        }
+    }
+
+    #[inline]
+    fn is_match(&self, state: &Self::State) -> bool {
+        match (self, state) {
+            (Self::Fuzzy(automaton), ExpansionAutomatonState::Fuzzy(state)) => {
+                automaton.is_match(state)
+            }
+            (Self::Prefix(automaton), ExpansionAutomatonState::Prefix(state)) => {
+                automaton.is_match(state)
+            }
+            _ => false,
+        }
+    }
+
+    #[inline]
+    fn can_match(&self, state: &Self::State) -> bool {
+        match (self, state) {
+            (Self::Fuzzy(automaton), ExpansionAutomatonState::Fuzzy(state)) => {
+                automaton.can_match(state)
+            }
+            (Self::Prefix(automaton), ExpansionAutomatonState::Prefix(state)) => {
+                automaton.can_match(state)
+            }
+            _ => false,
+        }
+    }
+
+    #[inline]
+    fn accept(&self, state: &Self::State, byte: u8) -> Self::State {
+        match (self, state) {
+            (Self::Fuzzy(automaton), ExpansionAutomatonState::Fuzzy(state)) => {
+                ExpansionAutomatonState::Fuzzy(automaton.accept(state, byte))
+            }
+            (Self::Prefix(automaton), ExpansionAutomatonState::Prefix(state)) => {
+                ExpansionAutomatonState::Prefix(automaton.accept(state, byte))
+            }
+            (Self::Fuzzy(_), _) => {
+                ExpansionAutomatonState::Fuzzy(FuzzyAutomatonState::Ascii(AsciiFuzzyState {
+                    levenshtein: None,
+                    exact_prefix_bytes_matched: None,
+                }))
+            }
+            (Self::Prefix(_), _) => ExpansionAutomatonState::Prefix(None),
+        }
+    }
+}
