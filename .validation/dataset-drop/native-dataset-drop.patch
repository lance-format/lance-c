 /// `lance-namespace-impls` depends on this crate, not the other way around.
 const NAMESPACE_TABLE_MARKERS: &[&str] = &[".lance-reserved", ".lance-deregistered"];

+/// Delete a dataset root and every object beneath it.
+///
+/// The caller resolves the URI and storage options into `object_store` and
+/// `base`. The same store and path are used for both validation and deletion.
+/// [`validate_dataset_root_for_drop`] must accept the root before deletion
+/// starts. Unmanaged files inside an accepted root are also deleted; objects
+/// outside it, including external base paths, are not traversed.
+///
+/// `ignore_not_found` suppresses only a native [`Error::NotFound`] returned by
+/// deletion. Validation errors and other deletion errors are propagated. A
+/// backend that treats deletion of an absent prefix as success retains that
+/// behavior even when `ignore_not_found` is false.
+///
+/// Validation and deletion are not atomic with concurrent writes, and a
+/// failed deletion may have removed some objects. This does not protect data
+/// referenced by shallow clones, invalidate open handles, or deregister a
+/// table from a namespace.
+pub async fn drop_dataset(
+    object_store: &ObjectStore,
+    base: &Path,
+    ignore_not_found: bool,
+) -> Result<()> {
+    validate_dataset_root_for_drop(object_store, base).await?;
+    match object_store.remove_dir_all(base.clone()).await {
+        Err(Error::NotFound { .. }) if ignore_not_found => Ok(()),
+        result => result,
+    }
+}
